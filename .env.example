# FitMate environment variables
# Copy this file to .env.local and fill in the values:  cp .env.example .env.local
# .env.local is git-ignored. Restart `npm run dev` after any change.
#
# Everything here is optional: without Supabase values FitMate runs fully local/offline.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the app. Used for auth email redirect links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase API  (Dashboard → Project Settings → API Keys)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser; access is limited by Row Level Security.
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_, never import them in client
# components, never commit real values.
# ---------------------------------------------------------------------------

# Secret key (sb_secret_...). Bypasses Row Level Security; used only by admin panel server code.
# A legacy "service_role" key also works here.
SUPABASE_SECRET_KEY=

# Postgres connection string with your database password. Only for running migrations or SQL
# from your machine (psql / Supabase CLI), never by the running app.
# Dashboard → Connect → "Session pooler":
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# YouTube Data API v3 key (server only) for recipe, form and music videos. Free: console.cloud.google.com > APIs > YouTube Data API v3 > Credentials.
YOUTUBE_API_KEY=

# Email (password reset codes) via Brevo, server only. Free 300/day: brevo.com > SMTP & API > API keys.
BREVO_API_KEY=
# A sender email verified in Brevo (Senders, domains & IPs). Shown as "FitMate <this email>".
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=FitMate

# ---------------------------------------------------------------------------
# Push notifications (Web Push / VAPID). Generate once: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only.
VAPID_PRIVATE_KEY=

# Shared secret for the reminder job (pg_cron -> /api/push/cron). Server only.
# Store the same value in Supabase Vault: select vault.create_secret('<value>', 'fitmate_cron_secret');
CRON_SECRET=
