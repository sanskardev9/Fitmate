# FitMate environment variables
# Copy this file to .env.local and fill in the values:  cp .env.example .env.local
# .env.local is git-ignored. Restart `npm run dev` after any change.
#
# Everything here is optional: without Supabase values FitMate runs fully local/offline.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the app. Used for auth email redirect links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase API  (Dashboard → Project Settings → API Keys)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser; access is limited by Row Level Security.
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_, never import them in client
# components, never commit real values.
# ---------------------------------------------------------------------------

# Secret key (sb_secret_...). Bypasses Row Level Security; used only by admin panel server code.
# A legacy "service_role" key also works here.
SUPABASE_SECRET_KEY=

# Postgres connection string with your database password. Used only by migration scripts
# (npm run db:migrate), never by the running app.
# Dashboard → Connect → "Session pooler":
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# YouTube Data API v3 key (server only) for recipe videos. Free: console.cloud.google.com > APIs > YouTube Data API v3 > Credentials.
YOUTUBE_API_KEY=
